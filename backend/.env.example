# Postgres connection string. For local dev you can use SQLite:
# DATABASE_URL=sqlite:///./vivifi.db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vivifi

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# Anthropic (Claude) — required for syllabus extraction. Empty is a valid dev
# state; the /courses/{slug}/syllabus endpoint will return a helpful 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# PDF upload cap in bytes (default 10 MiB per SPEC).
SYLLABUS_MAX_BYTES=10485760

# Google OAuth (optional). Leave blank to hide "Continue with Google".
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI must be exactly:
#   {BACKEND_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:8000
# SPA origin (no trailing slash). Local Vite, or GitHub Pages base like
# https://<user>.github.io/<repo>
FRONTEND_URL=http://localhost:5173
